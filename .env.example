# Copy this file to .env and fill in the values. Never commit .env.

DEBUG=True
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Local PostgreSQL (recommended): postgresql://<user>@localhost:5432/smartcart_db with DATABASE_SSL_REQUIRE=False
# Leave empty to use a local SQLite database (db.sqlite3).
# Example (Neon): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
DATABASE_SSL_REQUIRE=True

# Email. Without EMAIL_HOST, emails are printed to the terminal.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, use an App Password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SmartCart BD <noreply@example.com>
# none | optional | mandatory
ACCOUNT_EMAIL_VERIFICATION=optional

# SSLCommerz sandbox (free): https://developer.sslcommerz.com/registration/
# Leave empty to hide the online payment option.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=True
# Unpaid online orders are cancelled and restocked after this many minutes.
UNPAID_ORDER_TIMEOUT_MINUTES=60

# Google login (optional): https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shipping (BDT)
SHIPPING_INSIDE_DHAKA=60
SHIPPING_OUTSIDE_DHAKA=120
FREE_SHIPPING_MIN=2000

# ---- Production only (used when DEBUG=False) ----
# HTTPS: redirect http -> https, and HSTS (start small, raise to 31536000 once HTTPS works).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Product image storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2).
# Leave empty to store uploads on the local disk (fine locally, lost on Render/Railway redeploys).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 example: https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# Public domain for the bucket, e.g. pub-xxxx.r2.dev or cdn.example.com
AWS_S3_CUSTOM_DOMAIN=

# ---- Shop options ----
# Admin panel URL (keep it non-obvious). The admin is at /<ADMIN_URL>.
ADMIN_URL=manage-scb/
GIFT_WRAP_PRICE=50
RETURN_WINDOW_DAYS=7
REFERRAL_REWARD=100
# Floating chat buttons (leave empty to hide). WhatsApp in international format without '+'.
WHATSAPP_NUMBER=
MESSENGER_URL=
# Login lockout (django-axes): failed attempts before a lock, and how long it lasts.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
